{
    "extends": "@jterrazz/typescript/tsconfig/node",
    "compilerOptions": {
        // Every member is compiled by `tsc --build` as a project reference (D1), so
        // this tree emits where the preset only checks — and it compiles TypeScript
        // only, which is what `isolatedDeclarations` asks of the published member.
        "allowJs": false,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "noEmit": false,
        "sourceMap": true
    }
}

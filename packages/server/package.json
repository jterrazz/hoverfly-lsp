{
    "name": "@jterrazz/hoverfly-lsp",
    "version": "0.1.0",
    "description": "Language Server for Hoverfly JSON simulation files (stdio)",
    "keywords": [
        "api mocking",
        "hoverfly",
        "language-server",
        "lsp",
        "simulation"
    ],
    "homepage": "https://github.com/jterrazz/hoverfly-lsp#readme",
    "bugs": {
        "url": "https://github.com/jterrazz/hoverfly-lsp/issues"
    },
    "license": "MIT",
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/jterrazz/hoverfly-lsp",
        "directory": "packages/server"
    },
    "bin": {
        "hoverfly-lsp": "bin/hoverfly-lsp.js"
    },
    "files": [
        "bin",
        "dist/cli.cjs"
    ],
    "type": "module",
    "publishConfig": {

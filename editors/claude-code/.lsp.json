{
    "hoverfly": {
        "command": "node",
        "args": ["${CLAUDE_PLUGIN_ROOT}/bin/launch.mjs", "--stdio"],
        "extensionToLanguage": {
            ".json": "json",
            ".hfy": "hoverfly"
        },
        "transport": "stdio",
        "diagnostics": true,
        "maxRestarts": 3,
        "startupTimeout": 10000
    }
}

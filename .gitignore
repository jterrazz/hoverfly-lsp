# VS Code extension: the published server copied in at build time (see
# editors/vscode/esbuild.config.mjs). It ships INSIDE the .vsix at the path the
# extension resolves at runtime, so it is a product like dist/, not an artefact.
editors/vscode/server/

# IntelliJ plugin (Gradle). Commit the wrapper + sources; ignore the platform
# working directories Gradle and the IDE fix in place and cannot be told to move.
# The build directory IS movable and lives under .artifacts/ (build.gradle.kts).
editors/intellij/plugin/.gradle/
editors/intellij/plugin/.intellijPlatform/
editors/intellij/plugin/.kotlin/

# IntelliJ IDE project files
.idea/

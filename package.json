{
    "name": "hoverfly-lsp-monorepo",
    "version": "0.1.0",
    "private": true,
    "description": "Language Server for Hoverfly JSON simulation files",
    "license": "MIT",
    "author": "Jean-Baptiste Terrazzoni <contact@jterrazz.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/jterrazz/hoverfly-lsp"
    },
    "workspaces": [
        "packages/*",
        "editors/vscode",
        "specs"
    ],
    "type": "module",
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "docs:diagnostics": "node scripts/generate-diagnostic-docs.mjs && oxfmt docs/reference",
        "test": "npm run test --workspaces --if-present",
        "lint": "typescript check",
        "lint:fix": "typescript fix"
    },
    "devDependencies": {
        "@jterrazz/test": "file:.artifacts/packages/jterrazz-test-17.0.0.tgz",
        "@jterrazz/typescript": "file:.artifacts/packages/jterrazz-typescript-11.0.0.tgz",
        "@types/node": "^25.5.0",
        "glob": "^13.0.6",
        "vitest": "^5.0.1",
        "vscode-languageserver-protocol": "^3.18.0"
    },
    "engines": {
        "node": ">=24"
    }
}

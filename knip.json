{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    // `tsc --build` drives the project-reference build in every member; the compiler
    // arrives with @jterrazz/typescript, the one toolchain dependency this repo declares.
    "ignoreBinaries": ["tsc"],
    "workspaces": {
        ".": {
            "entry": ["oxfmt.config.ts", "oxlint.config.ts", "vitest.config.ts"],
            "ignore": ["editors/claude-code/bin/launch.cjs"]
        },
        "packages/analysis": {
            "entry": ["src/index.ts", "src/semantic/index.ts", "src/semantic/rules/index.ts"],
            "project": ["src/**/*.ts"],
            "ignoreDependencies": ["vscode-languageserver-types"]
        },
        "packages/server": {
            "entry": ["src/main.ts", "bin/hoverfly-lsp.js", "esbuild.config.js"],
            "project": ["src/**/*.ts"]
        },
        "editors/vscode": {
            "entry": ["src/extension.ts", "esbuild.config.mjs", "test/**/*.test.ts"],
            "project": ["src/**/*.ts", "test/**/*.ts"],
            "ignoreDependencies": ["@types/vscode", "@vscode/vsce"]
        }
    }
}
